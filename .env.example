DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-forte
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# URL pública do site (usada nos back_urls e no webhook do Mercado Pago)
SITE_URL=http://localhost:8000

# Opcional: origens extras aceitas em formulários (POST), separadas por
# vírgula. Por padrão já inclui o SITE_URL e domínios do cloudflared/ngrok.
# Em produção, normalmente não precisa mexer aqui.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Access Token da sua conta Mercado Pago (Painel > Suas integrações > Credenciais)
MERCADOPAGO_ACCESS_TOKEN=

PRODUCT_FILENAME=pack-audios.zip
PRODUCT_PRICE=47.00
DOWNLOAD_LINK_MAX_AGE=86400

# E-mail (Gmail) — gere uma "senha de app" em https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Cloudflare R2 (armazenamento do pack de áudios)
# Painel R2 > seu bucket > Configurações > API S3 (endpoint)
# Painel R2 > Manage R2 API Tokens > Create API Token (access key / secret key)
R2_ENDPOINT_URL=https://SEU-ACCOUNT-ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=arquivos-acervoaudio
R2_PRODUCT_KEY=privado/pack-audios.zip
R2_PRESIGNED_URL_EXPIRY=600

